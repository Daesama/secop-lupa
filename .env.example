# =====================================================================
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore: NUNCA se sube al repositorio.
# =====================================================================

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx        # secreto: solo server-side

# --- Claude API (Anthropic) — se usa a partir del Hito 2 ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Cron ---
# Debe tener >=16 caracteres. En Vercel, definirlo como env var hace que
# Vercel envíe automáticamente "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=cambia-esto-por-un-secreto-largo

# --- SECOP (opcional) ---
# Por defecto se usa el dataset público jbjy-vk9h. Solo cambiar si migras de dataset.
# SECOP_BASE_URL=https://www.datos.gov.co/resource/jbjy-vk9h.json
# App Token de Socrata (opcional): sube el límite de rate. Registro gratis en datos.gov.co.
# SECOP_APP_TOKEN=
# Máx. de páginas (x1000 contratos) por corrida del cron. Sube este valor para backfills.
# SYNC_MAX_PAGES=5
